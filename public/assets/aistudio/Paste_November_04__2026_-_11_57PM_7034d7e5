    document.getElementById('paymentForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const memberSelect = document.getElementById('memberSelect');
      const selectedMonths = Array.from(document.querySelectorAll('input[name="months"]:checked'))
        .map(cb => cb.value);
      const feeAmount = parseFloat(document.getElementById('feeAmount').value);

      if (!memberSelect.value) {
        showConfirmation('Please select a member', true);
        return;
      }

      if (selectedMonths.length === 0) {
        showConfirmation('Please select at least one month', true);
        return;
      }

      if (allMembers.length + allPayments.length + allTransactions.length >= 999) {
        showConfirmation('Maximum limit of 999 records reached. Please delete some records first.', true);
        return;
      }

      const memberPayments = allPayments.filter(p => p.member_name === memberSelect.value);
      const alreadyPaidMonths = [];
      memberPayments.forEach(payment => {
        const paidMonths = payment.months.split(', ');
        selectedMonths.forEach(month => {
          if (paidMonths.includes(month) && !alreadyPaidMonths.includes(month)) {
            alreadyPaidMonths.push(month);
          }
        });
      });

      if (alreadyPaidMonths.length > 0) {
        const duplicateWarning = document.getElementById('duplicateWarning');
        const duplicateList = document.getElementById('duplicateMonthsList');
        duplicateList.innerHTML = alreadyPaidMonths.map(month => `<li>${month}</li>`).join('');
        duplicateWarning.classList.remove('hidden');
        
        setTimeout(() => {
          duplicateWarning.classList.add('hidden');
        }, 5000);
      }

      const saveButton = document.getElementById('saveButton');
      saveButton.disabled = true;
      saveButton.textContent = 'Saving...';

      const payment = {
        id: Date.now().toString(),
        member_name: memberSelect.value,
        months: selectedMonths.join(', '),
        fee_amount: feeAmount,
        payment_date: new Date().toISOString(),
        type: 'payment',
        transaction_type: '',
        category: '',
        amount: 0,
        description: '',
        transaction_date: ''
      };

      const result = await window.dataSdk.create(payment);

      if (result.isOk) {
        showConfirmation('Payment recorded successfully!', false);
        document.getElementById('paymentForm').reset();
        updateMonthCheckboxStyling(new Set());
      } else {
        showConfirmation('Failed to save payment. Please try again.', true);
      }

      saveButton.disabled = false;
      saveButton.textContent = window.elementSdk?.config?.button_text || defaultConfig.button_text;
    });

