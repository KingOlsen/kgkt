  <script>
    const defaultConfig = {
      club_title: "SKAS | KGKT MANAGEMENT",
      page_title: "2026 Payment and Expense Tracker",
      button_text: "Save Payment",
      background_color: "#EEF2FF",
      card_background: "#FFFFFF",
      primary_color: "#4F46E5",
      text_color: "#1F2937",
      success_color: "#10B981"
    };

    let allPayments = [];
    let allMembers = [];
    let allTransactions = [];

    const dataHandler = {
      onDataChanged(data) {
        allPayments = data.filter(item => item.type === 'payment');
        allMembers = data.filter(item => item.type === 'member');
        allTransactions = data.filter(item => item.type === 'transaction');
        
        renderMembers();
        renderPaymentStatus();
        renderPaymentHistory();
        updateMemberDropdown();
        renderBudgetSummary();
        renderTransactions();
        updateCategoryFilter();
      }
    };

    async function onConfigChange(config) {
      const clubTitle = document.getElementById('clubTitle');
      const pageTitle = document.getElementById('pageTitle');
      const saveButton = document.getElementById('saveButton');
      const app = document.getElementById('app');

      clubTitle.textContent = config.club_title || defaultConfig.club_title;
      pageTitle.textContent = config.page_title || defaultConfig.page_title;
      saveButton.textContent = config.button_text || defaultConfig.button_text;

      const bgColor = config.background_color || defaultConfig.background_color;
      const primaryColor = config.primary_color || defaultConfig.primary_color;
      const textColor = config.text_color || defaultConfig.text_color;

      app.style.background = `linear-gradient(to bottom right, ${bgColor}, ${adjustBrightness(bgColor, -10)})`;
      clubTitle.style.color = primaryColor;
      pageTitle.style.color = adjustBrightness(textColor, 30);
      saveButton.style.backgroundColor = primaryColor;
      saveButton.style.color = config.card_background || defaultConfig.card_background;
    }

    function adjustBrightness(color, percent) {
      const num = parseInt(color.replace("#", ""), 16);
      const amt = Math.round(2.55 * percent);
      const R = (num >> 16) + amt;
      const G = (num >> 8 & 0x00FF) + amt;
      const B = (num & 0x0000FF) + amt;
      return "#" + (0x1000000 + (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 +
        (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 +
        (B < 255 ? B < 1 ? 0 : B : 255))
        .toString(16).slice(1);
    }

    // Auto-uppercase inputs
    document.getElementById('newMemberName').addEventListener('input', (e) => {
      e.target.value = e.target.value.toUpperCase();
    });

    document.getElementById('budgetDescription').addEventListener('input', (e) => {
      e.target.value = e.target.value.toUpperCase();
    });

    // Budget Functions
    function renderBudgetSummary() {
      const paymentIncome = allPayments.reduce((sum, p) => sum + p.fee_amount, 0);
      const transactionIncome = allTransactions
        .filter(t => t.transaction_type === 'income')
        .reduce((sum, t) => sum + t.amount, 0);
      const totalInc = paymentIncome + transactionIncome;

      const totalExp = allTransactions
        .filter(t => t.transaction_type === 'expense')
        .reduce((sum, t) => sum + t.amount, 0);

      const balance = totalInc - totalExp;

      document.getElementById('currentBalance').textContent = `$${balance.toFixed(2)}`;
      document.getElementById('totalIncome').textContent = `$${totalInc.toFixed(2)}`;
      document.getElementById('totalExpenses').textContent = `$${totalExp.toFixed(2)}`;
    }

    function renderTransactions() {
      const filterType = document.getElementById('filterType').value;
      const filterCategory = document.getElementById('filterCategory').value;
      
      let filtered = [...allTransactions];
      
      if (filterType !== 'all') {
        filtered = filtered.filter(t => t.transaction_type === filterType);
      }
      
      if (filterCategory !== 'all') {
        filtered = filtered.filter(t => t.category === filterCategory);
      }

      const transactionsList = document.getElementById('transactionsList');
      
      if (filtered.length === 0) {
        transactionsList.innerHTML = '<p class="text-gray-500 text-base">No transactions match your filters.</p>';
        return;
      }

      const sorted = filtered.sort((a, b) => 
        new Date(b.transaction_date) - new Date(a.transaction_date)
      );

      transactionsList.innerHTML = sorted.map(transaction => {
        const isIncome = transaction.transaction_type === 'income';
        const bgColor = isIncome ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200';
        const textColor = isIncome ? 'text-green-700' : 'text-red-700';
        const icon = isIncome ? '↑' : '↓';
        
        return `
          <div class="border-2 ${bgColor} rounded-lg p-4">
            <div class="flex justify-between items-start mb-2">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-2xl">${icon}</span>
                  <h3 class="font-bold text-lg text-gray-800">${transaction.description}</h3>
                </div>
                <p class="text-sm text-gray-600">${transaction.category}</p>
              </div>
              <div class="flex flex-col items-end gap-2">
                <span class="text-xl font-bold ${textColor}">${isIncome ? '+' : '-'}$${transaction.amount.toFixed(2)}</span>
                <div class="flex gap-2">
                  <button onclick="editTransaction('${transaction.__backendId}')" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-1 px-3 rounded text-sm transition">
                    Edit
                  </button>
                  <button onclick="deleteTransaction('${transaction.__backendId}')" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-1 px-3 rounded text-sm transition">
                    Delete
                  </button>
                </div>
              </div>
            </div>
            <p class="text-sm text-gray-500">${new Date(transaction.transaction_date).toLocaleDateString()}</p>
            <div id="confirm-delete-${transaction.__backendId}" class="hidden mt-3 p-3 bg-yellow-50 border-2 border-yellow-400 rounded-lg">
              <p class="text-yellow-800 text-sm mb-2">⚠️ Are you sure you want to delete this transaction?</p>
              <div class="flex gap-2">
                <button onclick="confirmDeleteTransaction('${transaction.__backendId}')" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-1 px-4 rounded text-sm">
                  Yes, Delete
                </button>
                <button onclick="cancelDeleteTransaction('${transaction.__backendId}')" class="bg-gray-400 hover:bg-gray-500 text-white font-semibold py-1 px-4 rounded text-sm">
                  Cancel
                </button>
              </div>
            </div>
            <div id="edit-${transaction.__backendId}" class="hidden mt-3 p-4 bg-blue-50 border-2 border-blue-400 rounded-lg">
              <h4 class="font-semibold text-blue-800 mb-3">Edit Transaction</h4>
              <div class="space-y-3">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Type</label>
                  <select id="edit-type-${transaction.__backendId}" class="w-full px-3 py-2 border-2 border-blue-200 rounded-lg text-sm">
                    <option value="income" ${isIncome ? 'selected' : ''}>Income</option>
                    <option value="expense" ${!isIncome ? 'selected' : ''}>Expense</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Category</label>
                  <input type="text" id="edit-category-${transaction.__backendId}" value="${transaction.category}" class="w-full px-3 py-2 border-2 border-blue-200 rounded-lg text-sm uppercase">
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Amount ($)</label>
                  <input type="number" id="edit-amount-${transaction.__backendId}" value="${transaction.amount}" step="0.01" min="0" class="w-full px-3 py-2 border-2 border-blue-200 rounded-lg text-sm">
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
                  <input type="text" id="edit-description-${transaction.__backendId}" value="${transaction.description}" class="w-full px-3 py-2 border-2 border-blue-200 rounded-lg text-sm uppercase">
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Date</label>
                  <input type="date" id="edit-date-${transaction.__backendId}" value="${new Date(transaction.transaction_date).toISOString().split('T')[0]}" class="w-full px-3 py-2 border-2 border-blue-200 rounded-lg text-sm">
                </div>
                <div class="flex gap-2">
                  <button onclick="saveEditTransaction('${transaction.__backendId}')" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded text-sm">
                    Save Changes
                  </button>
                  <button onclick="cancelEditTransaction('${transaction.__backendId}')" class="flex-1 bg-gray-400 hover:bg-gray-500 text-white font-semibold py-2 px-4 rounded text-sm">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function updateCategoryFilter() {
      const filterCategory = document.getElementById('filterCategory');
      const currentValue = filterCategory.value;
      const categories = new Set(['all']);
      
      allTransactions.forEach(t => categories.add(t.category));
      
      filterCategory.innerHTML = Array.from(categories).map(cat => 
        `<option value="${cat}">${cat === 'all' ? 'All Categories' : cat}</option>`
      ).join('');
      
      if (categories.has(currentValue)) {
        filterCategory.value = currentValue;
      }
    }

    function showBudgetConfirmation(message, isError) {
      const budgetConfirmation = document.getElementById('budgetConfirmation');
      const messageText = budgetConfirmation.querySelector('p');
      
      messageText.textContent = isError ? '✗ ' + message : '✓ ' + message;
      budgetConfirmation.className = isError 
        ? 'mt-6 p-4 bg-red-100 border-2 border-red-400 rounded-lg'
        : 'mt-6 p-4 bg-green-100 border-2 border-green-400 rounded-lg';
      messageText.className = isError ? 'text-red-800 font-semibold text-base' : 'text-green-800 font-semibold text-base';
      
      budgetConfirmation.classList.remove('hidden');
      
      setTimeout(() => {
        budgetConfirmation.classList.add('hidden');
      }, 3000);
    }

    function renderMembers() {
      const membersList = document.getElementById('membersList');
      
      if (allMembers.length === 0) {
        membersList.innerHTML = '<p class="text-gray-500 text-base">No members added yet. Add your first member above.</p>';
        return;
      }

      const sortedMembers = [...allMembers].sort((a, b) => 
        a.member_name.localeCompare(b.member_name)
      );

      membersList.innerHTML = sortedMembers.map(member => {
        const memberPayments = allPayments.filter(p => p.member_name === member.member_name);
        const totalPaid = memberPayments.reduce((sum, p) => sum + p.fee_amount, 0);
        
        return `
          <div class="border-2 border-indigo-100 rounded-lg p-4 hover:border-indigo-200 transition">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="font-bold text-lg text-gray-800">${member.member_name}</h3>
                <p class="text-sm text-gray-600">${memberPayments.length} payment(s) • Total: $${totalPaid.toFixed(2)}</p>
              </div>
              <button onclick="deleteMember('${member.__backendId}', '${member.member_name}')" class="delete-btn bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                Delete
              </button>
            </div>
            <div id="confirm-${member.__backendId}" class="hidden mt-3 p-3 bg-yellow-50 border-2 border-yellow-400 rounded-lg">
              <p class="text-yellow-800 text-sm mb-2">⚠️ This will delete the member and all their payment records. Are you sure?</p>
              <div class="flex gap-2">
                <button onclick="confirmDelete('${member.__backendId}', '${member.member_name}')" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-1 px-4 rounded text-sm">
                  Yes, Delete
                </button>
                <button onclick="cancelDelete('${member.__backendId}')" class="bg-gray-400 hover:bg-gray-500 text-white font-semibold py-1 px-4 rounded text-sm">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderPaymentStatus() {
      const statusGrid = document.getElementById('statusGrid');
      
      if (allMembers.length === 0) {
        statusGrid.innerHTML = '<p class="text-gray-500 text-base">No members added yet. Add members in the "Manage Members" tab to see payment status.</p>';
        return;
      }

      const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                      'July', 'August', 'September', 'October', 'November', 'December'];
      
      const sortedMembers = [...allMembers].sort((a, b) => 
        a.member_name.localeCompare(b.member_name)
      );

      const memberMonthStatus = {};
      sortedMembers.forEach(member => {
        memberMonthStatus[member.member_name] = {};
        months.forEach(month => {
          memberMonthStatus[member.member_name][month] = false;
        });
      });

      allPayments.forEach(payment => {
        const paidMonths = payment.months.split(', ');
        paidMonths.forEach(month => {
          if (memberMonthStatus[payment.member_name]) {
            memberMonthStatus[payment.member_name][month] = true;
          }
        });
      });

      statusGrid.innerHTML = `
        <table class="min-w-full border-collapse">
          <thead>
            <tr>
