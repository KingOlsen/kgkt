rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAmount(val, maxVal) {
      return (val is int || val is float) && val >= 0 && val <= maxVal;
    }

    // Entity Blueprint Validators (Anti-Update-Gap)
    function isValidMember(data) {
      return data.keys().hasAll(['memberName', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['memberName', 'ownerId', 'createdAt', 'updatedAt'])
        && data.memberName is string
        && data.memberName.size() >= 1
        && data.memberName.size() <= 100
        && data.memberName.matches('^[A-Z0-9 .,\'&()\\-/]+$')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['memberId', 'memberName', 'months', 'feeAmount', 'paymentDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['memberId', 'memberName', 'months', 'feeAmount', 'paymentDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.memberId is string
        && data.memberId.size() >= 1
        && data.memberId.size() <= 128
        && data.memberId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.memberName is string
        && data.memberName.size() >= 1
        && data.memberName.size() <= 100
        && data.memberName.matches('^[A-Z0-9 .,\'&()\\-/]+$')
        && data.months is string
        && data.months.size() >= 3
        && data.months.size() <= 200
        && data.months.matches('^[A-Za-z, ]+$')
        && isValidAmount(data.feeAmount, 1000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['transactionType', 'category', 'amount', 'description', 'transactionDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['transactionType', 'category', 'amount', 'description', 'transactionDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.transactionType is string
        && data.transactionType.size() >= 6
        && data.transactionType.size() <= 7
        && (data.transactionType == 'income' || data.transactionType == 'expense')
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 100
        && data.category.matches('^[A-Z0-9 &.,\'()\\-/]+$')
        && isValidAmount(data.amount, 10000000)
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 300
        && data.description.matches('^[A-Z0-9 &.,\'()\\-/#$:;!?+]+$')
        && data.transactionDate is string
        && data.transactionDate.size() == 10
        && data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClubConfig(data) {
      return data.keys().hasAll(['clubTitle', 'pageTitle', 'buttonText', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['clubTitle', 'pageTitle', 'buttonText', 'ownerId', 'createdAt', 'updatedAt'])
        && data.clubTitle is string
        && data.clubTitle.size() >= 1
        && data.clubTitle.size() <= 100
        && data.pageTitle is string
        && data.pageTitle.size() >= 1
        && data.pageTitle.size() <= 150
        && data.buttonText is string
        && data.buttonText.size() >= 1
        && data.buttonText.size() <= 60
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /members/{memberId}
    match /members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if existing().ownerId is string || true;
      allow create: if isValidId(memberId)
        && isValidMember(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(memberId)
        && isValidMember(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Rename Member
          incoming().diff(existing()).affectedKeys().hasOnly(['memberName', 'updatedAt'])
        );
      allow delete: if isValidId(memberId);
    }

    // Collection: /payments/{paymentId}
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId);
      allow list: if existing().ownerId is string || true;
      allow create: if isValidId(paymentId)
        && isValidPayment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/members/$(incoming().memberId));
      allow update: if isValidId(paymentId)
        && isValidPayment(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Payment Details
          incoming().diff(existing()).affectedKeys().hasOnly(['memberId', 'memberName', 'months', 'feeAmount', 'paymentDate', 'updatedAt'])
        )
        && exists(/databases/$(database)/documents/members/$(incoming().memberId));
      allow delete: if isValidId(paymentId);
    }

    // Collection: /transactions/{transactionId}
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId);
      allow list: if existing().ownerId is string || true;
      allow create: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Budget Transaction
          incoming().diff(existing()).affectedKeys().hasOnly(['transactionType', 'category', 'amount', 'description', 'transactionDate', 'updatedAt'])
        );
      allow delete: if isValidId(transactionId);
    }

    // Collection: /settings/{settingId}
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if existing().ownerId is string || true;
      allow create: if isValidId(settingId)
        && isValidClubConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isValidClubConfig(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Club Workspace Config
          incoming().diff(existing()).affectedKeys().hasOnly(['clubTitle', 'pageTitle', 'buttonText', 'updatedAt'])
        );
      allow delete: if isValidId(settingId);
    }
  }
}
