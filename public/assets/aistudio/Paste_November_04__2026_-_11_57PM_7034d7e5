    function updateMonthCheckboxStyling(paidMonths) {
      const monthLabels = document.querySelectorAll('.month-checkbox');
      monthLabels.forEach(label => {
        const month = label.dataset.month;
        const isPaid = paidMonths.has(month);
        const span = label.querySelector('span');
        
        if (isPaid) {
          label.classList.remove('border-slate-200', 'hover:border-blue-400', 'bg-white');
          label.classList.add('bg-gradient-to-br', 'from-green-50', 'to-emerald-50', 'border-green-400');
          span.classList.remove('text-slate-700');
          span.classList.add('text-green-800');
          if (!label.querySelector('.paid-indicator')) {
            const indicator = document.createElement('span');
            indicator.className = 'paid-indicator ml-auto text-green-600 font-bold text-lg';
            indicator.textContent = '✓';
            label.appendChild(indicator);
          }
        } else {
          label.classList.remove('bg-gradient-to-br', 'from-green-50', 'to-emerald-50', 'border-green-400');
          label.classList.add('border-slate-200', 'hover:border-blue-400', 'bg-white');
          span.classList.remove('text-green-800');
          span.classList.add('text-slate-700');
          const indicator = label.querySelector('.paid-indicator');
          if (indicator) {
            indicator.remove();
          }
        }
      });
    }

